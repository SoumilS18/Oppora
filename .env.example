# Oppora Environment Variables
# Keep secrets safe and never commit real values to version control.

# TinyFish API Key for live opportunity discovery & web page extraction
# Obtain from https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Optional: Google Gemini API Key for advanced AI eligibility matching & checklist synthesis
# (If omitted, Oppora uses its built-in deterministic heuristic matching engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Mode: 'live' or 'demo'. When set to 'demo' or when TINYFISH_API_KEY is empty,
# Oppora serves high-fidelity, clearly-labeled authentic benchmark opportunities.
OPPORA_DEFAULT_MODE=live
