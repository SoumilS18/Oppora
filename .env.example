# ==============================================================================
# OPPORA ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and configure your environment credentials.
# NEVER commit .env.local or service-role secrets to version control.
# ==============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Real Auth & Persistence)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Optional: Supabase Site URL (Used for production email redirect verification)
# NEXT_PUBLIC_SITE_URL=https://oppora.app

# 2. TINYFISH LIVE WEB AGENT EXTRACTION (Optional for live web scraping)
# Obtain from https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here

# 3. GOOGLE GEMINI AI (Optional for LLM synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. RESEND TRANSACTIONAL EMAIL (Optional for live supplier dispatch)
# Without this, Oppora allows creating, editing, and copying supplier drafts without sending.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM_ADDRESS=restock@your-verified-domain.com

# 5. PLATFORM RUNTIME & STORAGE CONFIGURATION
# OPPORA_STORAGE_BACKEND: Optional ('supabase' or 'memory'). Defaults to 'supabase' in production.
# OPPORA_STORAGE_BACKEND=supabase
OPPORA_DEFAULT_MODE=live

